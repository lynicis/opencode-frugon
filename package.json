{
  "name": "opencode-frugon",
  "version": "1.0.1",
  "type": "module",
  "description": "OpenCode plugin to log LLM usage natively for Frugon",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist/ --target=node",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "bun test --coverage --coverage-reporter=lcov"
  },
  "keywords": [
    "opencode",
    "frugon",
    "llm",
    "cost",
    "plugin"
  ],
  "author": {
    "name": "Emre Sırmalı",
    "email": "me@lynicis.dev",
    "url": "https://lynicis.dev"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.63.0"
  }
}
